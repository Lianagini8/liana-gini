# Защитные заголовки (24.10.2026). CSP не задаём: сайт собирается в браузере из unpkg (React + Babel).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 16.11.2026: .txt (llms.txt, robots.txt, ключ IndexNow) отдаём с кодировкой UTF-8.
# Без неё браузеры и часть роботов читают кириллицу в llms.txt как кракозябры.
<IfModule mod_mime.c>
  AddCharset UTF-8 .txt
</IfModule>

# 05.11.2026: один адрес сайта для поиска (www и /index.html → https://lianagini.ru/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # lianagini.online ведёт на lianagini.ru, но правило живёт не здесь: в панели
  # у .online свой сайт с папкой www/lianagini.online и своим .htaccess (16.11.2026).
  # Английская версия лежит в /en и доступна только как lianagini.com
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en(/|\?|\s)
  RewriteRule ^ - [R=404,L]
  RewriteCond %{HTTP_HOST} ^www\.lianagini\.com$ [NC]
  RewriteRule ^(.*)$ https://lianagini.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.lianagini\.ru$ [NC]
  RewriteRule ^(.*)$ https://lianagini.ru/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
  # Посадочные: /<адрес>/index.html → /<адрес>/. THE_REQUEST не даёт зациклиться на внутреннем DirectoryIndex.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(o-liane-gini|konsultaciya|baier-v-kitae|detskaya-odezhda|nizhnee-bele|gotovye-kollekcii|svoy-brend-odezhdy|rynki-guanchzhou|kontrol-kachestva|sportivnaya-odezhda|tkani|furnitura|soprovozhdenie-v-guanchzhou|kak-najti-fabriku|furnitura-s-logotipom)/index\.html[\s?]
  RewriteRule ^(o-liane-gini|konsultaciya|baier-v-kitae|detskaya-odezhda|nizhnee-bele|gotovye-kollekcii|svoy-brend-odezhdy|rynki-guanchzhou|kontrol-kachestva|sportivnaya-odezhda|tkani|furnitura|soprovozhdenie-v-guanchzhou|kak-najti-fabriku|furnitura-s-logotipom)/index\.html$ https://%{HTTP_HOST}/$1/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^lianagini\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/(assets|api|en|\.well-known)/
  RewriteRule ^(.*)$ /en/$1 [L]
</IfModule>

# Шаблоны блоков (*.dc.html) нужны сайту, но не поиску
<IfModule mod_headers.c>
  <FilesMatch "\.dc\.html$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
