# Защитные заголовки (24.10.2026). CSP не задаём: сайт собирается в браузере из unpkg (React + Babel).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 05.11.2026: один адрес сайта для поиска (www и /index.html → https://lianagini.ru/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 08.11.2026, временно: пока нет английской версии, lianagini.com ведёт на lianagini.ru
  RewriteCond %{HTTP_HOST} ^(www\.)?lianagini\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://lianagini.ru/$1 [R=302,L]
  RewriteCond %{HTTP_HOST} ^www\.lianagini\.ru$ [NC]
  RewriteRule ^(.*)$ https://lianagini.ru/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# Шаблоны блоков (*.dc.html) нужны сайту, но не поиску
<IfModule mod_headers.c>
  <FilesMatch "\.dc\.html$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
